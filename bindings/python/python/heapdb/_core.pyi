# -- the database --------------------------------------------------------------------------

class HeapDB:
    """An append-only event store answering "what most likely caused this?"."""

    def __init__(self, bucket_seconds: float = 900.0, max_sets_per_segment: int = 64) -> None: ...
    bucket_seconds: float
    max_sets_per_segment: int
    @property
    def pending_event_types(self) -> set[str]: ...
    def register_effect(self, name: str, kernel: Kernel,
                        priors: Mapping[str, tuple[float, float]] | None = None,
                        default_prior: tuple[float, float] = (1.0, 4.0),
                        cause_types: Iterable[str] | None = None, credit: str = "proportional",
                        global_pseudocount: float = 5.0, hierarchical: bool = True,
                        leak: float = 0.05, w_neg: float = 1.0,
                        repeatable: bool = True) -> EffectSpec: ...
    def effect(self, name: str) -> EffectSpec: ...
    @property
    def effects(self) -> list[str]: ...
    def register_event_type(self, type: str,
                            weight: Callable[[Mapping[str, Any]], float] | None = None) -> None: ...
    def add_rule(self, effect: str, name: str, predicate: Callable[[Event], bool] | None,
                 multiplier: float, types: Iterable[str] | None = None) -> Rule: ...
    def remove_rule(self, effect: str, name: str) -> None: ...
    def insert(self, entity: str, time: float, type: str,
               features: Iterable[str] | str | None = None, weight: float | None = None,
               attrs: Mapping[str, Any] | None = None) -> Event: ...
    def get(self, event_id: int) -> Event: ...
    def events(self, entity: str | None = None) -> Iterator[Event]: ...
    @property
    def entities(self) -> list[str]: ...
    def entity_log(self, entity: str) -> EntityLog | None: ...
    def link(self, effect: str, feature: str, entity: str | None = None) -> BetaCounts: ...
    def score(self, event: Event, effect: str, at: float) -> float: ...
    def explain(self, event: Event, effect: str, at: float) -> Explanation: ...
    def _window(self, spec: EffectSpec | str, at: float, within: float | None) -> tuple[float, float]: ...
    def segment_bound(self, spec: EffectSpec | str, seg: Segment, entity: str, at: float, t_lo: float,
                      t_hi: float, use_sets: bool = True, _cache: Any = None) -> tuple[float, bool]: ...
    def top_causes(self, entity: str, effect: str, at: float, k: int = 3, explain: bool = False,
                   within: float | None = None, _use_sets: bool = True) -> QueryResult: ...
    def top_causes_group(self, entities: Iterable[str], effect: str | Iterable[str], at: float,
                         k: int = 3, explain: bool = False,
                         within: float | None = None) -> QueryResult: ...
    def top_causes_naive(self, entity: str, effect: str, at: float, k: int = 3,
                         within: float | None = None) -> list[tuple[float, Event]]: ...
    def most_likely_cause(self, entity: str, effect: str, at: float) -> Cause | None: ...
    @overload
    def feature_risk(self, effect: str, features: Iterable[str] | str, weight: float | None = 1.0,
                     entity: str | None = None, type: str | None = None,
                     attrs: Mapping[str, Any] | None = None,
                     explain: Literal[False] = False) -> float: ...
    @overload
    def feature_risk(self, effect: str, features: Iterable[str] | str, weight: float | None = 1.0,
                     entity: str | None = None, type: str | None = None,
                     attrs: Mapping[str, Any] | None = None, *,
                     explain: Literal[True]) -> tuple[float, Explanation]: ...
    def rank_candidates(self, effect: str, candidates: Iterable[Candidate | Mapping[str, Any]],
                        k: int = 10, entity: str | None = None,
                        explain: bool = False) -> list[RankedCandidate]: ...
    def feedback(self, entity: str, effect_type: str, at_time: float,
                 confirmed_event_id: int | None = None, rejected_ids: Iterable[int] = (),
                 credit: str | None = None) -> FeedbackReport: ...
    def observe(self, entity: str, effect: str, at: float, leak: float | None = None) -> ObserveReport: ...
    def settle(self, until: float, effects: Iterable[str] | str | None = None,
               entity: str | None = None, partial: bool = False) -> SettleReport: ...
    def observation_stats(self, effect: str) -> dict[str, float]: ...
    def link_report(self, effect: str, entity: str | None = None, min_support: float = 1.0,
                    level: float = 0.9, baseline: float | str = "mean",
                    features: Iterable[str] | None = None) -> LinkReport: ...
    def calibration_records(self, effect: str) -> list[CalibrationRecord]: ...
    def calibration_report(self, effect: str, bins: int = 10) -> CalibrationReport: ...
    def forget_entity(self, entity: str, scrub_global: bool = False) -> dict[str, int]: ...
    def save(self, path: str | os.PathLike[str]) -> None: ...
    @classmethod
    def load(cls, path: str | os.PathLike[str]) -> HeapDB: ...
    def __len__(self) -> int: ...

# -- forward decay --------------------------------------------------------------------------

class Popped(Generic[T]):
    def __init__(self, item: T, score: float, handle: int) -> None: ...
    item: T
    score: float
    handle: int
    def __class_getitem__(cls, item: Any) -> GenericAlias: ...

class ForwardDecayHeap(Generic[T]):
    def __init__(self, lam: float) -> None: ...
    @classmethod
    def from_half_life(cls, half_life: float) -> ForwardDecayHeap[Any]: ...
    def __class_getitem__(cls, item: Any) -> GenericAlias: ...
    @property
    def lam(self) -> float: ...
    def key(self, weight: float, t: float) -> float: ...
    def score_at(self, key: float, now: float) -> float: ...
    def push(self, item: T, weight: float, t: float) -> int: ...
    def remove(self, handle: int) -> bool: ...
    def peek_top(self, now: float) -> Popped[T] | None: ...
    def pop(self, now: float) -> Popped[T] | None: ...
    def top_k(self, k: int, now: float) -> list[Popped[T]]: ...
    def compact(self) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[T]: ...

