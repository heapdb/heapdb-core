    def __init__(self, id: int, entity: str, time: float, type: str,
                 features: Iterable[str] = ..., weight: float = 1.0,
                 attrs: Mapping[str, Any] | None = None) -> None: ...
    @property
    def id(self) -> int: ...
    @property
    def entity(self) -> str: ...
    @property
    def time(self) -> float: ...
    @property
    def type(self) -> str: ...
    @property
    def features(self) -> frozenset[str]: ...
    @property
    def weight(self) -> float: ...
    @property
    def attrs(self) -> Mapping[str, Any]: ...
    def to_dict(self) -> dict[str, Any]: ...
    @classmethod
    def from_dict(cls, d: Mapping[str, Any]) -> Event: ...
    def short(self) -> str: ...
    def __hash__(self) -> int: ...

def format_time(t: float) -> str: ...
def validate_weight(weight: float) -> float: ...
def as_feature_set(features: Iterable[str] | str | None = None) -> frozenset[str]: ...

# -- kernels --------------------------------------------------------------------

class Kernel:
    """Base class for unimodal, peak-normalised, truncated lag kernels."""

    name: str
    @property
    def support(self) -> float: ...
    @property
    def min_lag(self) -> float: ...
    @property
    def mode(self) -> float: ...
    @property
    def max_value(self) -> float: ...
    def value(self, dt: float) -> float: ...
    def max_over(self, dt_lo: float, dt_hi: float) -> float: ...
    def mass_fraction(self, dt: float) -> float: ...
    def _raw(self, dt: float) -> float: ...
    def to_dict(self) -> dict[str, Any]: ...

class ExponentialDecay(Kernel):
    def __init__(self, half_life: float, horizon_half_lives: float = 10.0) -> None: ...
    @property
    def half_life(self) -> float: ...
    @property
    def horizon_half_lives(self) -> float: ...

class WindowKernel(Kernel):
    def __init__(self, min_lag: float = 0.0, max_lag: float = 3600.0) -> None: ...
    @property
    def max_lag(self) -> float: ...

class LogNormalKernel(Kernel):
    def __init__(self, median: float, sigma: float = 0.5, tail_sigmas: float = 4.0) -> None: ...
    @property
    def median(self) -> float: ...
    @property
    def sigma(self) -> float: ...
    @property
    def tail_sigmas(self) -> float: ...
    @property
    def _mu(self) -> float: ...

class GammaKernel(Kernel):
    def __init__(self, shape: float, scale: float, tail_stds: float = 6.0) -> None: ...
    @property
    def shape(self) -> float: ...
    @property
    def scale(self) -> float: ...
    @property
    def tail_stds(self) -> float: ...

def kernel_from_dict(d: Mapping[str, Any]) -> Kernel: ...

