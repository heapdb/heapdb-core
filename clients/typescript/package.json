{
  "name": "@heapdb/client",
  "version": "0.1.0",
  "description": "TypeScript client for the HeapDB Data API (hosted HeapDB Cloud or self-hosted heapdb-server).",
  "license": "Apache-2.0",
  "author": "HeapDB",
  "homepage": "https://github.com/heapdb/heapdb-core/tree/main/clients/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heapdb/heapdb-core.git",
    "directory": "clients/typescript"
  },
  "bugs": {
    "url": "https://github.com/heapdb/heapdb-core/issues"
  },
  "keywords": [
    "heapdb",
    "causal",
    "root-cause",
    "attribution",
    "database",
    "client"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "20.19.43",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
